# AI Video Editor Production Environment Variables

# Gemini API Key (Default server key - users can also bring their own BYOB key in UI)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# App URL Configuration
NEXTAUTH_URL=http://your-azure-vm-ip-or-domain:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Redis Queue Connection
REDIS_URL=redis://redis:6379

# Storage Path Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
REMOTION_CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser
