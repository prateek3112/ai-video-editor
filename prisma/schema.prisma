generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id        String    @id @default(uuid())
  videoUrl  String
  duration  Float
  status    String    @default("processing")
  createdAt DateTime  @default(now())
  captions  Caption[]
}

model Caption {
  id        String  @id @default(uuid())
  projectId String
  start     Float
  end       Float
  text      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Style {
  id     String @id @default(uuid())
  name   String
  config String
}
